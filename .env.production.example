NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_SSL=false
DATABASE_URL=postgres://pos_app:CHANGE_ME_APP_PASSWORD@postgres:5432/pos_backend
MIGRATION_DATABASE_URL=postgres://pos_migrator:CHANGE_ME_MIGRATOR_PASSWORD@postgres:5432/pos_backend
APP_ORIGIN=https://api.example.com
# Comma-separated exact browser origins allowed to call the API. APP_ORIGIN is always included.
CORS_ORIGINS=
SESSION_COOKIE_NAME=pos_session
PLATFORM_ADMIN_EMAIL=admin@example.com
INVITATION_BASE_URL=https://app.example.com/invitations
LOG_LEVEL=info
POSTGRES_DB=pos_backend
POSTGRES_USER=pos_migrator
POSTGRES_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
POSTGRES_APP_USER=pos_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
