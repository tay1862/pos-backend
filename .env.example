NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# The app connects with a non-owner role so PostgreSQL RLS is enforced.
DATABASE_URL=postgres://pos_app:pos_app@localhost:5432/pos_backend
# Release migrations run with the database owner role, separately from the app.
MIGRATION_DATABASE_URL=postgres://pos_migrator:pos_migrator@localhost:5432/pos_backend
DATABASE_SSL=false
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=pos_session
PLATFORM_ADMIN_EMAIL=admin@example.com
INVITATION_BASE_URL=http://localhost:3000/invitations
LOG_LEVEL=info
